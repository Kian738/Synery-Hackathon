# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Optional cloud Text-to-Speech (ElevenLabs or OpenAI).
# If omitted, Floorwise automatically uses the browser's built-in Web Speech API (speechSynthesis).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Or OpenAI TTS:
OPENAI_API_KEY=

# Optional: OpenRouteService for the outdoor leg between buildings (walk, wheelchair, bike, car).
# Without a key, or if it is refused, routing falls back to the public OSM routers (routing.openstreetmap.de),
# then to a labelled straight-line estimate. The base URL can be changed with ORS_API_URL.
ORS_API_KEY=
# ORS_API_URL=https://api.heigit.org/openrouteservice
